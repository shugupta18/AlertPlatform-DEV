										"value": "IF NOT EXISTS (SELECT * FROM sys.external_data_sources WHERE name = 'MyAdlsBlob')\nBEGIN\n  CREATE EXTERNAL DATA SOURCE MyAdlsBlob\n  WITH (\n    LOCATION = 'https://dotpladlsv2.blob.core.windows.net/synapsecontainer'\n  );\nEND\n\n\n\nIF NOT EXISTS (SELECT * FROM sys.external_file_formats WHERE name = 'ParquetFileFormat')\nBEGIN\n  CREATE EXTERNAL FILE FORMAT ParquetFileFormat\n  WITH (\n    FORMAT_TYPE = PARQUET\n  );\nEND\n\n\nIF OBJECT_ID('dbo.booking_aggregates_ext') IS NOT NULL\n  DROP EXTERNAL TABLE dbo.booking_aggregates_ext;\n\n\nCREATE EXTERNAL TABLE dbo.booking_aggregates_ext\nWITH (\n  LOCATION = 'aggregates/Indecab_Network_Requests_Agg/@{pipeline().RunId}/',\n  DATA_SOURCE = MyAdlsBlob,\n  FILE_FORMAT = ParquetFileFormat\n)\nAS\nSELECT DISTINCT\n    '@{pipeline().RunId}'      AS run_id,\n    'indecab_dashboard'        AS integration_name,\n\tPK_ID \t\t\t\t\t   AS record_id,\n    1 AS row_number,\n    status                     AS status,\n    CONCAT('status = ', status) AS details\nFROM OPENROWSET(\n    BULK 'Staging/ITH/Indecab_Dashboard/*.parquet',\n    DATA_SOURCE = 'MyAdlsBlob',\n    FORMAT = 'PARQUET'\n) WITH (\n    PK_ID INT,\n    event_id NVARCHAR(200),\n    received_signature NVARCHAR(200),\n    event_name NVARCHAR(200),\n    _id NVARCHAR(200),\n    fromCity NVARCHAR(200),\n    toCity NVARCHAR(200),\n    pickUpTime DATETIME,\n    dropOffTime DATETIME,\n    reportingTime TIME,\n    companyName NVARCHAR(200),\n    reportingAddress NVARCHAR(500),\n    dropAddress NVARCHAR(500),\n    dutyType_name NVARCHAR(200),\n    dutyType_type NVARCHAR(200),\n    dutyType_maxKms INT,\n    dutyType_maxHours INT,\n    vehicleGroup NVARCHAR(200),\n    requestHash NVARCHAR(200),\n    is_processed INT,\n    status NVARCHAR(200),\n    processed_datetime DATETIME,\n    API_response_code NVARCHAR(50),\n    API_response NVARCHAR(MAX),\n    CDAT DATETIME,\n    UIDC NVARCHAR(200),\n    MDAT DATETIME,\n    UIDM NVARCHAR(200)\n) r\nWHERE status IS NOT NULL;\n",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
